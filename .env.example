# SmartDoc Scanner — Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase (required) ──────────────────────────────────────
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # ⚠️ Never expose this to the client

# ── Site URL (used in invite emails) ────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000         # Change to your production URL

# ── Part A: Workspace Invitations ───────────────────────────
INVITE_SECRET=your-random-32-char-secret           # Used to sign/verify JWT invite tokens
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx             # Resend email API key (optional — invite URL shown if missing)

# ── Part B: AI Insights (added later) ───────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxx

# ── Part C: Accounting Integrations (added later) ───────────
# QB_CLIENT_ID=
# QB_CLIENT_SECRET=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=                            # 32-byte hex key for pgcrypto token encryption
